# ── Database ──────────────────────
DATABASE_URL=postgresql://...

# ── Supabase ──────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Upstash Redis ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare R2 ─────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zyloshipping-assets
R2_PUBLIC_URL=

# ── Algolia ───────────────────────
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_SEARCH_ONLY_KEY=
ALGOLIA_INDEX_NAME=products

# ── OpenAI ────────────────────────
OPENAI_API_KEY=

# ── Razorpay (UPI + Cards + NetBanking + Wallets) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Stripe (International) ────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── UPI specific ──────────────────
# Razorpay handles UPI natively — no extra keys needed.
# Set your UPI VPA below for display / manual fallback
MERCHANT_UPI_VPA=zyloshipping@upi

# ── Email ─────────────────────────
RESEND_API_KEY=

# ── Suppliers ─────────────────────
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
CJ_ACCESS_TOKEN=
CJ_EMAIL=

# ── Tracking ──────────────────────
AFTERSHIP_API_KEY=

# ── Auth ──────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── App ───────────────────────────
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
