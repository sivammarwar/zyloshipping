# Browser-visible API base (no trailing slash)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4000

# Same as the URL users open in the browser (CORS + links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side proxy to Express (Railway private URL optional)
BACKEND_URL=http://127.0.0.1:4000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here   # generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret