# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/zyloshipping?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-32-chars

# ── Redis (required for caching, sessions, job queue) ────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI / LLM (Groq is primary, OpenAI is fallback) ───────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your-openai-api-key-here-optional
OPENAI_MODEL=gpt-4o

# ── Search (Algolia for product search) ──────────────────────────────────────
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_ADMIN_KEY=your_algolia_admin_key
ALGOLIA_SEARCH_KEY=your_algolia_search_only_key

# ── Payment Gateways ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Email (Resend for transactional emails) ──────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── Shipping & Tracking ───────────────────────────────────────────────────────
AFTERSHIP_API_KEY=your_aftership_api_key

# ── Supplier APIs (for product sync) ─────────────────────────────────────────
ALIEXPRESS_API_KEY=your_aliexpress_api_key
CJ_DROPSHIPPING_API_KEY=your_cj_api_key

# ── Encryption (for storing sensitive API keys in database) ──────────────────
ENCRYPTION_KEY=your-32-character-encryption-key-for-aes256

# ── Admin Credentials (seed script) ───────────────────────────────────────────
ADMIN_EMAIL=admin@zyloshipping.com
ADMIN_PASSWORD=@3088shivA+her

# ── Monitoring & Logging (optional) ───────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info